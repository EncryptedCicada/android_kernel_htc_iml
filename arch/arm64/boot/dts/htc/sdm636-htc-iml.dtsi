&cci {
	/delete-node/ qcom,ois@0;
	/delete-node/ qcom,tof@29;
};

&i2c_1 {
	/delete-property/ pinctrl-2;
	pinctrl-names = "i2c_active", "i2c_sleep";
};

&i2c_2 {
	/delete-property/ pinctrl-2;
	pinctrl-names = "i2c_active", "i2c_sleep";
};

&i2c_3 {
	/delete-property/ pinctrl-2;
	pinctrl-names = "i2c_active", "i2c_sleep";
};

&i2c_4 {
	/delete-property/ pinctrl-2;
	pinctrl-names = "i2c_active", "i2c_sleep";
};

&i2c_5 {
	/delete-property/ pinctrl-2;
	pinctrl-names = "i2c_active", "i2c_sleep";
};

&i2c_6 {
	/delete-property/ pinctrl-2;
	pinctrl-names = "i2c_active", "i2c_sleep";
};

&i2c_7 {
	/delete-property/ pinctrl-2;
	pinctrl-names = "i2c_active", "i2c_sleep";
};

&i2c_8 {
	/delete-property/ pinctrl-2;
	pinctrl-names = "i2c_active", "i2c_sleep";
};

&i2c_6 {
	/delete-node/ nq@28;
};

&i2c_7 {
	status = "okay";
	nq@28 {
		compatible = "qcom,nq-nci";
		reg = <0x28>;
		qcom,nq-irq = <&tlmm 28 0x00>;
		qcom,nq-ven = <&tlmm 29 0x00>;
		qcom,nq-firm = <&tlmm 30 0x00>;
		qcom,nq-clkreq = <&pm660_gpios 4 0x00>;
		qcom,nq-esepwr = <&tlmm 31 0x00>;
		interrupt-parent = <&tlmm>;
		qcom,clk-src = "BBCLK3";
		interrupts = <28 0>;
		interrupt-names = "nfc_irq";
		pinctrl-names = "nfc_active", "nfc_suspend";
		pinctrl-0 = <&nfc_int_active &nfc_enable_active>;
		pinctrl-1 = <&nfc_int_suspend &nfc_enable_suspend>;
		clocks = <&clock_rpmcc RPM_LN_BB_CLK3_PIN>;
		clock-names = "ref_clk";
	};
};

/* Remove useless node
&hostless {
	audio_test_mod {
		compatible = "qcom,audio-test-mod";
	};
};
*/

&spmi_bus {
	qcom,pm660@0 {
		qcom,power-on@800 {
			qcom,pon_1 {
				qcom,support-reset = <1>;
				qcom,s1-timer = <4480>;
				qcom,s2-timer = <2000>;
				qcom,s2-type = <7>;
			};
		};

		pm660_charger: qcom,qpnp-smb2 {
			qcom,usb-icl-ua = <2150000>;
			qcom,dc-icl-ua = <2150000>;
			qcom,fcc-max-ua = <2150000>;
			qcom,fv-max-uv = <4400000>;
			qcom,sw-jeita-enable;
			qcom,thermal-mitigation
					= <2000000 1500000 1000000 800000
						500000 200000>;
		};

		pm660_fg: qpnp,fg {
			qcom,fg-jeita-thresholds = <0x03 0x0a 0x2d 0x32>;
			qcom,fg-chg-term-current = <150>;
			qcom,fg-sys-term-current = <0xfffffed4>;
			qcom,fg-jeita-hyst-temp = <3>;
			qcom,fg-recharge-voltage = <4350>;
		};
	};

	qcom,pm660@1 {
		pm660_haptics: qcom,haptic@c000 {
			qcom,actuator-type = "erm";
			qcom,vmax-mv = <3000>;
			qcom,brake-pattern = <0x00>;
		};
	};

	pm660l_3: qcom,pm660l@3 {
		qcom,leds@d000 {
			red_led: qcom,rgb_0 {
				qcom,idx-len = <100>;
				qcom,duty-pcts = [64 00 00 00 00 00 00 00 00 00 00];
			};

			green_led: qcom,rgb_1 {
				qcom,start-idx = <0>;
				qcom,idx-len = <100>;
				qcom,duty-pcts = [64 00 00 00 00 00 00 00 00 00 00];
				qcom,use-blink;
			};
			
			blue_led: qcom,rgb_2 {
				qcom,idx-len = <100>;
				qcom,duty-pcts = <64 00 00 00 00 00 00 00 00 00 00>;
				qcom,use-blink;
			};

		};
		
		pm660l_wled: qcom,leds@d800 {
			qcom,ovp-mv = <31100>;
		};
	};
};

&sdhc_2 {
	cd-gpios = <&tlmm 54 0x0>;
};

&pm660_vadc {
	chan@51 { /* quiet_therm */
		qcom,scale-function = <2>;
	};
	
	chan@4e { /* emmc_therm */
		qcom,scale-function = <2>;
	};
	
	chan@4f { /* pa_therm0 */
		qcom,scale-function = <2>;
	};
	
	chan@4d { /* msm_therm */
		qcom,scale-function = <2>;
	};
	
	chan@4c { /* xo_therm */
		qcom,scale-function = <4>;
	};
};

