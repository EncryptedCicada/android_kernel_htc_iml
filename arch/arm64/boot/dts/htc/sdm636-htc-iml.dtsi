#include "sdm630-htc-common.dtsi"
#include "dsi-panel-htc-iml.dtsi"
#include "sdm630-htc-iml-camera-sensor.dtsi"
#include "sdm636-htc-iml-touch.dtsi"
#include "charger-htc-iml.dtsi"
#include "sdm636-htc-iml-codec.dtsi"
#include "sdm630-htc-nfc.dtsi"
#include "sdm630-htc-sensors.dtsi"

&soc {
	int_codec: sound {
		qcom,msm-micbias1-ext-cap;
		qcom,msm-hs-micbias-type = "external";
		qcom,audio-routing =
		"RX_BIAS", "INT_MCLK0",
		"SPK_RX_BIAS", "INT_MCLK0",
		"INT_LDO_H", "INT_MCLK0",
		"RX_I2S_CLK", "INT_MCLK0",
		"TX_I2S_CLK", "INT_MCLK0",
		"MIC BIAS External", "Handset Mic",
		"MIC BIAS External2", "Headset Mic",
		"MIC BIAS External", "Secondary Mic",
		"AMIC1", "MIC BIAS External",
		"AMIC2", "MIC BIAS External2",
		"AMIC3", "MIC BIAS External",
		"DMIC1", "MIC BIAS External",
		"MIC BIAS External", "Digital Mic1",
		"DMIC2", "MIC BIAS External",
		"MIC BIAS External", "Digital Mic2",
		"DMIC3", "MIC BIAS External",
		"MIC BIAS External", "Digital Mic3",
		"DMIC4", "MIC BIAS External",
		"MIC BIAS External", "Digital Mic4",
		"SpkrLeft IN", "SPK1 OUT",
		"SpkrRight IN", "SPK2 OUT",
		"PDM_IN_RX1", "PDM_OUT_RX1",
		"PDM_IN_RX2", "PDM_OUT_RX2",
		"PDM_IN_RX3", "PDM_OUT_RX3",
		"ADC1_IN", "ADC1_OUT",
		"ADC2_IN", "ADC2_OUT",
		"ADC3_IN", "ADC3_OUT";
		
		qcom,wsa-max-devs = <2>;
		qcom,wsa-aux-dev-prefix = "SpkrLeft", "SpkrRight",
		"SpkrLeft", "SpkrRight";
	};
	
	qusb_phy0: qusb@c012000 {
		qcom,tune2-efuse-num-bits = <0x04>;
		qcom,qusb-phy-init-seq = <0xf8 0x80
		0xb3 0x84
		0x83 0x88
		0xc0 0x8c
		0x30 0x08
		0x79 0x0c
		0x21 0x10
		0x14 0x9c
		0x9f 0x1c
		0x00 0x18>;
	};

	wdog: qcom,wdt@17817000 {
		qcom,bark-time = <15000>;
	};

	clock_cpu: qcom,clk-cpu-660@179c0000 {
		reg = <0x179c0000 0x4000>, <0x17916000 0x1000>,
		      <0x17816000 0x1000>, <0x179d1000 0x1000>,
		      <0x00784130 0x8>, <0x00784130 0x8>, 
			  <0x17914800 0x800>;
		reg-names = "osm", "pwrcl_pll", "perfcl_pll",
				"apcs_common", "pwrcl_efuse",
				"perfcl_efuse", "pwrcl_acd";
		qcom,acdtd-val = <0xa111 0xa111>;
		qcom,acdcr-val = <0x2c5ffd 0x2c5ffd>;
		qcom,acdsscr-val = <0x901 0x901>;
		qcom,acdextint0-val = <0x2cf9ae8 0x2cf9ae8>;
		qcom,acdextint1-val = <0x2cf9afe 0x2cf9afe>;
		qcom,acdautoxfer-val = <0x15 0x15>;
		qcom,pc-override-index = <0x00 0x00>;
	};

	/delete-node/ qcom,rmtfs_sharedmem@0;

	qcom,rmtfs_sharedmem@85e00000 {
		compatible = "qcom,sharedmem-uio";
		reg = <0x85e00000 0x200000>;
		reg-names = "rmtfs";
		qcom,client-id = <0x00000001>;
	};

	qcom,glink-smem-native-xprt-adsp@86000000 {
		/delete-property/ cpu-affinity;
	};

	qcom,lpass@15700000 {
		/delete-property/ reg-names;
	};

	pil_modem: qcom,mss@4080000 {
		/delete-property/ qcom,complete-ramdump;
	};

	/* This is probably not needed now that we are building for a version
	* after original kernel and this change was introduced later.
	* Also our device is eMMC.
	ufs1: ufshc@1da4000 {
		/delete-property/ pinctrl-names;
		/delete-property/ pinctrl-0;
		/delete-property/ pinctrl-1;
	};
	*/
	apc0_cpr: cprh-ctrl@179c8000 {
		thread@0 {
			apc0_pwrcl_vreg: regulator {
				qcom,cpr-closed-loop-voltage-fuse-adjustment =
					<(-32000) (-30000) (-29000) (-38000)
					(-36000)>;
			};
		};
	};

	msm_gpu: qcom,kgsl-3d0@5000000 {
		qcom,gpu-pwrlevel-bins {
			qcom,gpu-pwrlevels-3 {
				/* SVS_L1 */
				qcom,gpu-pwrlevel@2 {
					qcom,bus-freq = <10>;
					qcom,bus-min = <9>;
					qcom,bus-max = <11>;
				};

				/* SVS */
				qcom,gpu-pwrlevel@3 {
					qcom,bus-freq = <9>;
					qcom,bus-min = <9>;
					qcom,bus-max = <11>;
				};

				/* Low SVS */
				qcom,gpu-pwrlevel@4 {
					qcom,bus-freq = <4>;
					qcom,bus-max = <8>;
				};
			};

			/delete-node/ qcom,gpu-pwrlevels-6;
		};
	};

	qcom,msm-dai-mi2s {
		dai_mi2s0: qcom,msm-dai-q6-mi2s-prim {
			qcom,msm-mi2s-rx-lines = <1>;
			qcom,msm-mi2s-tx-lines = <2>;
		};
	};
};

&tlmm {
	/* This is probably not needed now that we are building for a version
	* after original kernel and this change was introduced later.
	* Also our device is eMMC.
	/delete-node/ ufs_dev_reset_assert;
	*/	

	msm_gpio_20: msm_gpio_20 {
		mux{
			pins="gpio20";
			function= "gpio";
		};
		config {
			pins= "gpio20";
			drive-strength = <2>;
			bias-disable;
			output-low;
		
		};
	};

	msm_gpio_20_output_high: msm_gpio_20_output_high {
		mux {
			pins = "gpio20";
			function = "gpio";

		};
		config{
			pins = "gpio20";
			drive-strength = <2>;
			bias-disable;
			output-high;
		};
	
	};

	msm_gpio_72: msm_gpio_72{
		mux{
			pins = "gpio72";
			function = "gpio";
		};
		config{
			pins = "gpio72";
			drive-strength=<2>;
			bias-pull-down;
		};
	};

	pri_mi2s_sck {
		pri_mi2s_sck_sleep: pri_mi2s_sck_sleep {
			mux {
				pins = "gpio12";
				function = "gpio";
			};

			config {
				pins = "gpio12";
				drive-strength = <2>;   /* 2 mA */
				bias-pull-down;         /* PULL DOWN */
				input-enable;
			};
		};

		pri_mi2s_sck_active: pri_mi2s_sck_active {
			mux {
				pins = "gpio12";
				function = "pri_mi2s";
			};

			config {
				pins = "gpio12";
				drive-strength = <8>;   /* 8 mA */
				bias-disable;           /* NO PULL */
				output-high;
			};
		};
	};

	pri_mi2s_ws {
		pri_mi2s_ws_sleep: pri_mi2s_ws_sleep {
			mux {
				pins = "gpio13";
				function = "gpio";
			};

			config {
				pins = "gpio13";
				drive-strength = <2>;   /* 2 mA */
				bias-pull-down;         /* PULL DOWN */
				input-enable;
			};
		};

		pri_mi2s_ws_active: pri_mi2s_ws_active {
			mux {
				pins = "gpio13";
				function = "pri_mi2s_ws";
			};

			config {
				pins = "gpio13";
				drive-strength = <8>;   /* 8 mA */
				bias-disable;           /* NO PULL */
				output-high;
			};
		};
	};

	pri_mi2s_sd0 {
		pri_mi2s_sd0_sleep: pri_mi2s_sd0_sleep {
			mux {
				pins = "gpio14";
				function = "gpio";
			};

			config {
				pins = "gpio14";
				drive-strength = <2>;   /* 2 mA */
				bias-pull-down;         /* PULL DOWN */
				input-enable;
			};
		};

		pri_mi2s_sd0_active: pri_mi2s_sd0_active {
			mux {
				pins = "gpio14";
				function = "pri_mi2s";
			};

			config {
				pins = "gpio14";
				drive-strength = <8>;   /* 8 mA */
				bias-disable;           /* NO PULL */
			};
		};
	};

	pri_mi2s_sd1 {
		pri_mi2s_sd1_sleep: pri_mi2s_sd1_sleep {
			mux {
				pins = "gpio15";
				function = "gpio";
			};

			config {
				pins = "gpio15";
				drive-strength = <2>;   /* 2 mA */
				bias-pull-down;         /* PULL DOWN */
				input-enable;
			};
		};

		pri_mi2s_sd1_active: pri_mi2s_sd1_active {
			mux {
				pins = "gpio15";
				function = "pri_mi2s";
			};

			config {
				pins = "gpio15";
				drive-strength = <8>;   /* 8 mA */
				bias-disable;           /* NO PULL */
			};
		};
	};

	hall_int_pin: hall_int_pin {
		hall_int_active: hall_int_active {
			mux {
				pins = "gpio75";
				function = "gpio";
			};

			config {
				pins = "gpio75";
				drive-strength = <0x6>;
				bias-pull-up;
			};
		};

		hall_int_suspend: hall_int_suspend {
			mux {
				pins = "gpio75";
				function = "gpio";
			};

			config {
				pins = "gpio75";
				drive-strength = <0x6>;
				bias-pull-up;
			};
		};
	};

